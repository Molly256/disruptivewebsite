generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  username String @unique
  phone String @unique
  countryCode String
  countryName String
  loginPassword String
  transactionPassword String
  gender String
  inviteCode String? // who invited them
  myInviteCode String? @unique // THEIR OWN AUTO GENERATED CODE
  referralCode String @unique
  avatar String?

  // VIP & TASK FIELDS
  vipLevel Int @default(1)
  vipId Int @default(1)
  currentSet Int @default(1)
  setCompleted Int @default(0)
  taskCompleted Int @default(0)
  totalTasks Int @default(40)

  // MONEY FIELDS
  walletBalance Float @default(0.00)
  holdAmount Float @default(0.00)
  bonus Float @default(0.00)
  specialBonus Float @default(0.00)
  todayProfit Float @default(0.00)
  lastProfitReset DateTime @default(now()) // REMOVED DUPLICATE
  creditScore Int @default(100)
  isAdmin Boolean @default(false)

  // TASK DATA
  currentTaskProducts Json @default("[]")
  activeProducts Json @default("[]")
  completedProducts Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  merges TaskMerge[]
  notifications Notification[]
  adminLogs AdminLog[]
}

model Transaction {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  type String
  amount Float
  status String @default("pending")
  account String?
  createdAt DateTime @default(now())
}

model TaskMerge {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  vipSet String
  photoIds String[]
  createdAt DateTime @default(now())
}

model Notification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  message String
  isRead Boolean @default(false)
  createdAt DateTime @default(now())
}

model AdminLog {
  id String @id @default(cuid())
  adminId String
  action String
  createdAt DateTime @default(now())
  user User? @relation(fields: [adminId], references: [id])
}