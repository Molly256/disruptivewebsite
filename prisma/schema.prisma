generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  username String @unique
  phone String @unique
  countryCode String
  countryName String
  loginPassword String
  transactionPassword String
  gender String

  inviteCode String @unique
  referredBy String?

  avatar String?

  // VIP & TASK FIELDS - ADMIN CONTROLLED
  vipLevel Int @default(1)
  vipId Int @default(1)

  currentDay Int @default(1) // 1 to 5. Admin sets this
  currentSet Int @default(1) // 1 to 3. Admin sets this
  tasksInCurrentSet Int @default(0) // 0-120. Progress in current set
  taskCompleted Int @default(0) // total tasks done ever
  totalTasks Int @default(40) // for display. changes per vip

  // MONEY FIELDS
  walletBalance Float @default(0.00)
  holdAmount Float @default(0.00)
  freezeAmount Float @default(0.00)
  bonus Float @default(0.00)
  specialBonus Float @default(0.00)
  todayProfit Float @default(0.00)
  lastProfitReset DateTime @default(now())
  creditScore Int @default(100)
  isAdmin Boolean @default(false)

  // BIND WALLET - ONLY LINE ADDED
  boundWallet Json?

  // TASK DATA
  currentTaskProducts Json @default("[]") // active task snapshot
  activeProducts Json @default("[]") // duplicate for frontend
  completedProducts Json @default("[]") // history of completed products
  x10TaskNumbers Json @default("[]") // [3,7,15] task numbers that get x10 profit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  tasks Task[]
  notifications Notification[]
  adminLogs AdminLog[]

  @@index([username])
  @@index([phone])
  @@index([inviteCode])
}

// Task table: 1 row per task submission
model Task {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  vipLevel Int
  day Int // 1 to 5
  setNumber Int // 1 to 3

  progress String @default("0/40") // "D1 S2 T5/40"
  status String @default("pending") // "pending" | "completed"

  products Json @default("[]") // [{id, name, price, profit, image}]
  taskCode String? @unique // unique code for this task

  createdAt DateTime @default(now())
  completedAt DateTime?

  @@index([userId, status])
  @@index([userId, day, setNumber])
  @@index([taskCode])
}

model Transaction {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type String // deposit, withdraw, profit, reserve
  amount Float
  status String @default("pending") // pending, success, failed
  account String? // bank, usdt address

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([status])
}

model Notification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  message String
  isRead Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model AdminLog {
  id String @id @default(cuid())
  adminId String
  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  action String // "reset_set", "change_vip", "add_balance"
  targetUserId String?
  details Json?

  createdAt DateTime @default(now())
}

model TaskSetConfig {
  id String @id @default(cuid())
  vipLevel Int
  day Int
  setNum Int
  data Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vipLevel, day, setNum])
  @@index([vipLevel, day])
}