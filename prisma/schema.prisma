generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  username String @unique
  phone String @unique
  countryCode String
  countryName String
  loginPassword String
  transactionPassword String
  gender String

  inviteCode String @unique // THIS IS THEIR OWN CODE TO SHARE
  referredBy String? // THIS STORES WHO INVITED THEM. ex: 345678DI

  avatar String?

  // VIP & TASK FIELDS - NEW SYSTEM
  vipLevel Int @default(1)
  vipId Int @default(1)

  setsCompleted Int @default(0) // 0 = Set1, 1 = Set2 done. Only admin changes this
  tasksInCurrentSet Int @default(0) // 0-40. This is what moves 0/40 on button

  taskCompleted Int @default(0) // total tasks done ever. for history
  totalTasks Int @default(40) // for display

  // MONEY FIELDS
  walletBalance Float @default(0.00)
  holdAmount Float @default(0.00)
  bonus Float @default(0.00)
  specialBonus Float @default(0.00)
  todayProfit Float @default(0.00)
  lastProfitReset DateTime @default(now())
  creditScore Int @default(100)
  isAdmin Boolean @default(false)

  // TASK DATA
  currentTaskProducts Json @default("[]")
  activeProducts Json @default("[]")
  completedProducts Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  tasks Task[] // ADDED: relation to tasks
  merges TaskMerge[]
  notifications Notification[]
  adminLogs AdminLog[]
}

// NEW: Task table for Records page
model Task {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  vipLevel Int // so we know which vip folder to pull images from
  setNumber Int // 1 or 2
  progress String // "3/40"
  productId Int // index from vip1Set1.js

  price Float // snapshot price at time of task
  totalPrice Float
  totalProfit Float

  status String @default("pending") // "pending" | "completed"

  taskCode String @unique // 202607290000016

  createdAt DateTime @default(now())
  completedAt DateTime?
}

model Transaction {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  type String
  amount Float
  status String @default("pending")
  account String?
  createdAt DateTime @default(now())
}

model TaskMerge {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  vipSet String
  photoIds String[]
  createdAt DateTime @default(now())
}

model Notification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  message String
  isRead Boolean @default(false)
  createdAt DateTime @default(now())
}

model AdminLog {
  id String @id @default(cuid())
  adminId String
  action String
  createdAt DateTime @default(now())
  user User? @relation(fields: [adminId], references: [id])
}